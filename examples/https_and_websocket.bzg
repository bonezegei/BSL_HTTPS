include("lib/https.bzg");

// Initialize the server on port 443 with your SSL certificates
var server = createHTTPSServer(443, "t_cert.pem", "t_key.pem");


// STANDARD HTTPS ROUTING (GET / POST)

server.get = function (path, requestRaw) {
    print("GET request to: " + path);
    if (path == "/") {
        server.sendFile("index.html");
    } else {
        server.sendResponse("{\"status\":\"success\"}", "application/json",200);
    }
    gc();
};

server.post = function (path, requestRaw) {
    print("POST request to: " + path);
    if (path == "/api") {
        server.sendResponse("{\"status\":\"success\"}", "application/json");
    } else {
        server.sendResponse("{\"status\":\"success\"}", "application/json",200);
    }
    gc();
};

// SECURE WEBSOCKET (WSS) EVENT HANDLERS
// Triggered when a client successfully connects via wss://

server.onConnect = function (clientId) {
    print("WebSocket connected! Client ID: " + clientId);
    gc();
};

// Triggered when a client sends a message
server.onData = function (message, clientId) {
    print("Received from Client " + clientId + ": " + message);
    server.send(clientId, message);
    gc();
};

// Triggered when a client disconnects
server.onDisconnect = function (clientId) {
    print("WebSocket disconnected! Client ID: " + clientId);
    gc();
};

// START THE SERVER
print("Starting Secure Web Server on port 443...");
server.run();
